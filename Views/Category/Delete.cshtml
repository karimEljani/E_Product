@model TP_Product.Models.Category
@{
    ViewData["Title"] = "Delete";
}
<h1>Delete</h1>
<h3>Êtes-vous sûr de vouloir supprimer cette catégorie ?</h3>
<p class="text-danger">Attention : les articles de cette catégorie seront également supprimés.</p>
<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CategoryName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CategoryName)</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="CategoryId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
